# PostgreSQL connection (Docker Compose defaults)
POSTGRES_USER=corner
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=corner
DATABASE_URL=postgresql+asyncpg://corner:change-me-db-password@postgres:5432/corner

# Runtime paths & public URLs
DATA_DIR=/data
DATA_DIR_HOST=./data
API_PORT=8000
BASE_URL=https://example.com
SITE_URL=https://example.com/life
API_PREFIX=/api/life
CORS_ORIGINS=["http://localhost:3000","https://example.com"]

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-random-64-char-hex-secret

# Identity & Comments
ALLOW_ANON_COMMENTS=true
OWNER_TG_ID=123456789
OWNER_RESERVED_NAMES=["owner","admin","administrator","root","system"]

# Telegram (Kurigram MTProto Bot Client — Epoch 2)
TG_API_ID=123456
TG_API_HASH=replace-with-tg-api-hash
TG_BOT_TOKEN=123456:replace-with-bot-token
TG_CHANNEL_ID=-1001234567890
TG_DISCUSSION_CHAT_ID=-1001234567891
TG_SESSION_NAME=bot
# Optional read-only MTProto User Client (live owner-poll votes, reading reactions, channel deletions)
# Generate TG_USER_SESSION_STRING via: uv run python -m app.cli login-tg-user
# TG_USER_SESSION_STRING=
# TG_USER_SESSION_NAME=user_reader

# OAuth & Telegram Login Widget
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Generic OpenID Connect (Clerk, Logto, Auth0, Authentik, Keycloak, Pocket ID, Zitadel)
# OIDC_ISSUER_URL=https://auth.example.com/application/o/corner
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# OIDC_PROVIDER_NAME=SSO
# OIDC_SCOPES=openid email profile
TG_LOGIN_BOT_USERNAME=replace_with_bot_username

# SMTP Notifications (aiosmtplib)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# Background Intervals, ALTCHA & Feeds
RECONCILE_INTERVAL_SECONDS=900
EMAIL_DEBOUNCE_SECONDS=120
ALTCHA_MAX_NUMBER=100000
EXPORT_PAGE_SIZE=50
FEED_TITLE=Life
FEED_DESCRIPTION=Life updates
FEED_LANGUAGE=en
FEED_AUTHOR=Author
FEED_IMAGE_URL=
FEED_MAX_ITEMS=100
